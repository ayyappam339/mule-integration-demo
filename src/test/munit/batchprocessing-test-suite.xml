	<munit:config name="batchprocessing-test-suite.xml" />
	<munit:test name="batchprocessing-test-suite-batchprocessingFlowTest" doc:id="e6771814-1f2f-44ec-8092-8d7a07308159" description="Test">
		<munit:behavior >
