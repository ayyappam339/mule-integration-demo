				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="gfh" attributeName="doc:name" />
					<munit-tools:with-attribute whereValue="93b95b82-64e1-432a-a7d7-bd41815ccd17" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:variables >
						<munit-tools:variable key="team" value="#[{}]" />
					</munit-tools:variables>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:spy doc:name="Spy" doc:id="ce08f789-6c50-43fc-a876-8c8a25d4c0ed" processor="logger">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="ON COMPLETE Logger" attributeName="doc:name" />
					<munit-tools:with-attribute whereValue="e68ca3cc-db53-49c4-a161-72a1a9b94b1b" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:before-call >
